generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("STAFF") 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Application {
  id               String   @id @default(cuid())
  firstName        String
  lastName         String
  dob              DateTime
  gender           String
  previousSchool   String?
  parentName       String
  email            String
  phone            String
  paymentReference String?
  status           String   @default("PAID")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Student {
  id               String   @id 
  password         String   @default("student123") // NEW: Student Login Password
  firstName        String
  lastName         String
  dob              DateTime
  gender           String
  imageUrl         String?
  badges           String?
  classId          String?
  class            Class?   @relation(fields: [classId], references: [id])
  parentId         String?
  parent           Parent?  @relation(fields: [parentId], references: [id])
  previousSchool   String?
  status           String   @default("ACTIVE") 
  enrollmentDate   DateTime @default(now())
  grades           Grade[]
  invoices         Invoice[]
  skillRatings     SkillRating[]
  cbtResults       CBTResult[] 
  internalResults  InternalResult[] 
  conversations    Conversation[]
  attendance       Attendance[]
  behaviorRecords  BehaviorRecord[]
  smsNotifications SMSNotification[]
  portfolio        Portfolio[]
  practiceSessions PracticeSession[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Parent {
  tickets           Ticket[]
  conversations     Conversation[]
  smsNotifications  SMSNotification[]
  id                String    @id @default(cuid())
  password          String    @default("parent123") // NEW: Parent Login Password
  fullName          String
  email             String?
  phone             String
  students          Student[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Staff {
  id          String   @id 
  firstName   String
  lastName    String
  email       String?  @unique
  phone       String
  role        String   @default("TEACHER") 
  status      String   @default("ACTIVE")  
  classes     Class[]  
  timetableEntries TimetableEntry[] 
  lessonPlans LessonPlan[] 
  conversations Conversation[]
  videoMeetings VideoMeeting[]

  hireDate    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Class {
  id        String    @id @default(cuid())
  name      String    @unique 
  level     String    
  teacherId String?
  teacher   Staff?    @relation(fields: [teacherId], references: [id])
  students  Student[]
  timetableEntries TimetableEntry[]
  internalExams    InternalExam[]
  questionBank     QuestionBank[] 
  lessonPlans      LessonPlan[] 
  attendance        Attendance[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Subject {
  id        String    @id @default(cuid())
  name      String    @unique 
  grades    Grade[]
  timetableEntries TimetableEntry[]
  internalExams    InternalExam[]
  questionBank     QuestionBank[] 
  lessonPlans      LessonPlan[] 
  ministrySchemes  MinistryScheme[] 
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model TimetableEntry {
  id        String   @id @default(cuid())
  dayOfWeek String   
  startTime String   
  endTime   String   
  room      String?  
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   Staff?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Grade {
  id        String   @id @default(cuid())
  ca1       Float?   @default(0)
  ca2       Float?   @default(0)
  exam      Float?   @default(0)
  total     Float?   @default(0)
  letter    String?  
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term      String   
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([studentId, subjectId, term])
}

model SkillRating {
  id        String   @id @default(cuid())
  category  String   
  name      String   
  rating    Int      
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term      String   
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([studentId, name, term])
}

model Invoice {
  id          String   @id 
  description String   
  amount      Float
  status      String   @default("PENDING") 
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  issuedDate  DateTime @default(now())
  dueDate     DateTime
  paidDate    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ------------------------------------------------------
// EXTERNAL ENTRANCE EXAMS (CBT)
// ------------------------------------------------------
model EntranceExam {
  id              String   @id @default(cuid())
  title           String   
  description     String?
  scheduledDate   DateTime
  startTime       String   
  durationMinutes Int      @default(60)
  status          String   @default("UPCOMING") 
  questions       ExamQuestion[]
  results         CBTResult[] 
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ExamQuestion {
  id            String   @id @default(cuid())
  section       String   @default("English Studies") 
  text          String   
  imageUrl      String?  
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String   
  marks         Float    @default(1.0)
  orderIndex    Int      
  examId        String
  exam          EntranceExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CBTResult {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examId      String
  exam        EntranceExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  score       Float
  totalMarks  Float
  submittedAt DateTime @default(now())
  @@unique([studentId, examId])
}

// ------------------------------------------------------
// INTERNAL EXAMS (CBT)
// ------------------------------------------------------
model InternalExam {
  id              String   @id @default(cuid())
  title           String   
  classId         String
  class           Class    @relation(fields: [classId], references: [id])
  subjectId       String
  subject         Subject  @relation(fields: [subjectId], references: [id])
  term            String   @default("Term 1 - 2024")
  durationMinutes Int      @default(60)
  isActive        Boolean  @default(false)
  shuffleQuestions Boolean @default(false) 
  questions       InternalQuestion[]
  results         InternalResult[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model InternalQuestion {
  id            String   @id @default(cuid())
  text          String   
  imageUrl      String?  
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String   
  marks         Float    @default(1.0)
  orderIndex    Int      
  examId        String
  exam          InternalExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model InternalResult {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examId      String
  exam        InternalExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  score       Float
  totalMarks  Float
  submittedAt DateTime @default(now())
  @@unique([studentId, examId])
}

// ------------------------------------------------------
// QUESTION BANK 
// ------------------------------------------------------
model QuestionBank {
  id            String   @id @default(cuid())
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId       String?
  class         Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  text          String   
  imageUrl      String?  
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String   
  marks         Float    @default(1.0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ------------------------------------------------------
// MINISTRY SCHEME OF WORK 
// ------------------------------------------------------
model MinistryScheme {
  id          String   @id @default(cuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  level       String   
  week        Int
  topic       String
  objectives  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ------------------------------------------------------
// LESSON PLANS 
// ------------------------------------------------------
model LessonPlan {
  id            String   @id @default(cuid())
  title         String
  week          Int      @default(1)
  
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId       String
  class         Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId     String?
  teacher       Staff?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  
  schemeOfWork  String?  
  lessonNote    String?
  evaluation    String?
  assignment    String?

  status        String   @default("DRAFT") 

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ------------------------------------------------------
// CONFIGURATION
// ------------------------------------------------------
model AcademicTerm {
  id        String   @id @default(cuid())
  name      String   
  session   String   
  isCurrent Boolean  @default(false)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  type        String   @default("GENERAL") 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Ticket {
  id        String   @id @default(cuid())
  subject   String
  status    String   @default("OPEN")
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id])
  messages  TicketMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketMessage {
  id        String   @id @default(cuid())
  body      String
  sender    String  
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// ------------------------------------------------------
// PARENT-TEACHER CHAT
// ------------------------------------------------------
model Conversation {
  id          String   @id @default(cuid())
  parentId    String
  parent      Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     Staff    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId   String?
  student     Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  lastMessage String?
  status      String   @default("ACTIVE") // ACTIVE, ARCHIVED
  messages    ChatMessage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([parentId, teacherId, studentId])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       // Parent ID or Staff ID
  senderType     String       // PARENT or TEACHER
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

// ------------------------------------------------------
// ATTENDANCE SYSTEM
// ------------------------------------------------------
model Attendance {
  id        String   @id @default(cuid())
  date      DateTime
  status    String   // PRESENT, ABSENT, LATE
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  markedBy  String?  // Staff ID who marked attendance
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([studentId, date])
}

// ------------------------------------------------------
// BEHAVIORAL MERIT/DEMERIT SYSTEM
// ------------------------------------------------------
model BehaviorRecord {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type        String   // MERIT, DEMERIT
  points      Int      // Positive for merit, negative for demerit
  category    String   // ACADEMIC, DISCIPLINE, LEADERSHIP, COMMUNITY, SPORTS
  title       String   // e.g., "Perfect Attendance", "Helping a Classmate"
  description String?
  awardedBy   String   // Staff ID
  term        String
  createdAt   DateTime @default(now())
}

// ------------------------------------------------------
// SMS NOTIFICATIONS
// ------------------------------------------------------
model SMSNotification {
  id          String   @id @default(cuid())
  parentId    String
  parent      Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId   String?
  student     Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  type        String   // ATTENDANCE, RESULT, ANNOUNCEMENT, FEE_REMINDER
  message     String
  status      String   @default("PENDING") // PENDING, SENT, FAILED, DELIVERED
  termiiMessageId String? // Termii API message ID
  sentAt      DateTime?
  createdAt   DateTime @default(now())
}

// ------------------------------------------------------
// STUDENT DIGITAL PORTFOLIO
// ------------------------------------------------------
model Portfolio {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String   // ACADEMIC, ARTS, SPORTS, LEADERSHIP, COMMUNITY, PROJECT
  fileUrl     String?  // URL to uploaded file
  imageUrl    String?  // URL to image/thumbnail
  isPublic    Boolean  @default(true)
  term        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VideoMeeting {
  id          String   @id @default(cuid())
  title       String
  description String?
  hostId      String   // Staff ID who created the meeting
  host        Staff    @relation(fields: [hostId], references: [id], onDelete: Cascade)
  meetingUrl  String   // Video meeting URL
  scheduledAt DateTime
  duration    Int      @default(30) // Duration in minutes
  type        String   // PARENT_TEACHER, CLASS, EVENT, OFFICE_HOURS
  status      String   @default("SCHEDULED") // SCHEDULED, ONGOING, COMPLETED, CANCELLED
  participants VideoParticipant[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VideoParticipant {
  id          String       @id @default(cuid())
  meetingId   String
  meeting     VideoMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId      String       // Parent ID or Staff ID
  userType    String       // PARENT, TEACHER, STUDENT
  joinedAt    DateTime?
  leftAt      DateTime?
  createdAt   DateTime     @default(now())
}

// ------------------------------------------------------
// JAMB, WAEC & NECO CBT PRACTICE SYSTEM
// ------------------------------------------------------
model PracticeSession {
  id          String   @id @default(cuid())
  studentId   String?
  student     Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examType    String   // JAMB, WAEC, NECO
  subject     String
  totalQuestions Int
  correctAnswers Int
  score       Float    // Percentage
  timeTaken   Int      // In seconds
  completed   Boolean  @default(false)
  answers     PracticeAnswer[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PracticeAnswer {
  id            String   @id @default(cuid())
  sessionId     String
  session       PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionNumber Int
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String   // A, B, C, or D
  selectedAnswer String? // A, B, C, D, or null if skipped
  isCorrect     Boolean
  explanation   String?  // Detailed solution
  topic         String?  // e.g., "Algebra", "Organic Chemistry"
  timeTaken     Int      // In seconds
  createdAt     DateTime @default(now())
}
